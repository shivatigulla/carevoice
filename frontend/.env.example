# CareVoice frontend. Copy to frontend/.env and fill in.
# Only PUBLIC values go here — everything prefixed VITE_ is shipped to the browser.
# Never put the service role key in this file.

# https://<project-ref>.supabase.co
VITE_SUPABASE_URL=
# Dashboard → Project Settings → API Keys → anon / publishable key
VITE_SUPABASE_ANON_KEY=
VITE_API_URL=http://localhost:8000
VITE_VOICE_URL=http://localhost:8001
