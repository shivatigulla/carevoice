# CareVoice backend + worker. Copy to backend/.env and fill in. Never commit .env.
# See README.md → "Where to find each key".

# --- Supabase ---------------------------------------------------------------
# Session pooler connection string (Dashboard → Connect → Session pooler), password filled in:
#   postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=
# https://<project-ref>.supabase.co
SUPABASE_URL=
# Service role key: server-side only. Never put this in the frontend.
SUPABASE_SERVICE_ROLE_KEY=
# Project Settings → JWT Keys → Legacy JWT secret. Used to verify staff logins on API calls.
SUPABASE_JWT_SECRET=

# --- LLM (OpenAI) -----------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_SUMMARY_MODEL=gpt-4.1-mini

# --- Speech (Sarvam AI) -----------------------------------------------------
SARVAM_API_KEY=
SARVAM_STT_MODEL=saaras:v3
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_SPEAKER=

# --- Telephony: exotel | twilio --------------------------------------------
TELEPHONY_PROVIDER=exotel
EXOTEL_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_SUBDOMAIN=api.exotel.com
EXOPHONE=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_NUMBER=

# --- Service wiring ---------------------------------------------------------
# Public HTTPS URL that reaches this machine (e.g. an ngrok/cloudflared tunnel) for telephony webhooks.
PUBLIC_BASE_URL=
BACKEND_URL=http://localhost:8000
# Shared secret between the voice service and the backend. Any long random string.
INTERNAL_API_KEY=
# Optional: comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Seeding (npm run db:seed) ---------------------------------------------
# Your own phone in E.164 (e.g. +919876543210) — seeded as a test patient for test calls.
SEED_TEST_PHONE=
# Optional: the test patient's name and date of birth (used to verify you on test calls).
SEED_TEST_NAME=Priya Reddy
SEED_TEST_DOB=1995-06-15
DEMO_ADMIN_EMAIL=
DEMO_ADMIN_PASSWORD=

# --- Cost table (INR) for per-call cost analytics --------------------------
# Fill these from your providers' current pricing pages. 0 = not counted.
PRICE_TELEPHONY_INR_PER_MIN=0
PRICE_STT_INR_PER_SEC=0
PRICE_TTS_INR_PER_1K_CHARS=0
PRICE_LLM_INPUT_INR_PER_1M_TOKENS=0
PRICE_LLM_OUTPUT_INR_PER_1M_TOKENS=0

TZ=Asia/Kolkata
